---
import { Icon } from "astro-icon/components";

import { urlFor } from "../../utils/urlFor";

type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

<ul class="article-tag-list">
  {
    tags.map((tag) => {
      return (
        <li class="article-tag-list-item" data-aos="zoom-in">
          <Icon
            name="fa6-solid:tag"
            style="margin-right: 8px; vertical-align: bottom;"
          />
          <a
            class="article-tag-list-link"
            href={urlFor(`tags/${tag}`)}
            rel="tag"
          >
            {tag}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .article-tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .article-tag-list-link {
    color: var(--red-1);
    text-decoration: none;
  }
  .article-tag-list-item {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    text-transform: uppercase;
    background: var(--red-5);
    color: var(--red-1);
    border-radius: 8px;
    padding: 8px 16px;
    margin: 0 12px 16px 0;
    box-shadow: var(--shadow-meta);
  }
</style>
