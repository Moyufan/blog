---
import fs from "node:fs";
import path from "node:path";
import { urlFor } from "../utils/urlFor";
import { playlist } from "../data/playlist";

const defaultCover = urlFor("images/notebook.png");

// 构建时扫描 public/music：把音频丢进这个目录就会自动进歌单
const musicDir = path.join(process.cwd(), "public", "music");
const localFiles = fs.existsSync(musicDir)
  ? fs
      .readdirSync(musicDir)
      .filter((file) => /\.(mp3|wav|m4a|ogg|flac)$/i.test(file))
      .sort((a, b) => a.localeCompare(b, "zh-CN"))
  : [];

const localTracks = localFiles.map((file) => {
  const stem = file.replace(/\.[^.]+$/, "");
  const parts = stem.split(/\s+-\s+/);
  const artist = parts.length > 1 ? parts[0] : "本地音乐";
  const title = parts.length > 1 ? parts.slice(1).join(" - ") : stem;
  return {
    title,
    artist,
    src: urlFor(`/music/${encodeURIComponent(file)}`),
    cover: defaultCover,
  };
});

const tracks = [...localTracks, ...playlist].map((track, index) => ({
  index,
  title: track.title,
  artist: track.artist,
  src: urlFor(track.src),
  cover: urlFor(track.cover || "/images/notebook.png"),
}));
---

<div class="music-player" id="music-player" transition:persist>
  <button class="mp-fab" id="mp-fab" type="button" aria-label="打开音乐播放器" title="音乐播放器 · 点击页面开启声音">
    <img src={defaultCover} alt="" width="30" height="30" />
    <span class="mp-eq" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

  <section class="mp-panel" id="mp-panel" aria-label="音乐播放器">
    <header class="mp-header">
      <span class="mp-title">播放列表 <small>{tracks.length} 首</small></span>
      <button class="mp-icon-btn mp-close" id="mp-close" type="button" aria-label="收起">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z" /></svg>
      </button>
    </header>

    <div class="mp-filter">
      <label class="mp-filter-label" for="mp-artist-select">歌手</label>
      <div class="mp-select-wrap">
        <select id="mp-artist-select" class="mp-select" aria-label="按歌手筛选">
          <option value="">全部（{tracks.length} 首）</option>
        </select>
        <svg class="mp-select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z" /></svg>
      </div>
    </div>

    <div class="mp-now">
      <img id="mp-cover" src={tracks[0]?.cover || defaultCover} alt="" width="54" height="54" />
      <div class="mp-meta">
        <strong id="mp-now-title">{tracks[0]?.title || "暂无歌曲"}</strong>
        <small id="mp-now-artist">{tracks[0]?.artist || "在 src/data/playlist.ts 添加歌曲"}</small>
      </div>
    </div>

    <p class="mp-hint" id="mp-hint">浏览器限制有声自动播放，点击页面任意位置即可开启声音</p>

    <div class="mp-progress-row">
      <input id="mp-progress" class="mp-range" type="range" min="0" max="1000" value="0" aria-label="播放进度" />
      <div class="mp-time"><span id="mp-current">0:00</span><span id="mp-duration">0:00</span></div>
    </div>

    <div class="mp-controls">
      <button class="mp-icon-btn" id="mp-prev" type="button" aria-label="上一首" title="上一首">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h3v14H6zM20 5l-11 7 11 7V5z" /></svg>
      </button>
      <button class="mp-play" id="mp-play" type="button" aria-label="播放" title="播放/暂停">
        <svg id="mp-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      </button>
      <button class="mp-icon-btn" id="mp-next" type="button" aria-label="下一首" title="下一首">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5h3v14h-3zM4 5l11 7-11 7V5z" /></svg>
      </button>
      <button class="mp-icon-btn mp-loop" id="mp-loop" type="button" aria-label="循环播放" title="循环播放">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z" /></svg>
      </button>
    </div>

    <div class="mp-volume-row">
      <span>音量</span>
      <input id="mp-volume" class="mp-range" type="range" min="0" max="100" value="25" aria-label="音量" />
    </div>

    <ul class="mp-list" id="mp-list">
      {
        tracks.length
          ? tracks.map((track, i) => (
              <li class="mp-track" data-index={i} title={track.title}>
                <span class="mp-num">{i + 1}</span>
                <span class="mp-track-text">
                  <strong>{track.title}</strong>
                  <small>{track.artist}</small>
                </span>
                <span class="mp-playing-bars" aria-hidden="true"><i></i><i></i><i></i></span>
              </li>
            ))
          : <li class="mp-empty">暂无歌曲，去 src/data/playlist.ts 添加吧</li>
      }
    </ul>
  </section>

  <audio id="mp-audio" preload="none"></audio>
</div>

<script define:vars={{ tracks }}>
(function () {
  const root = document.getElementById("music-player");
  if (!root || root.dataset.ready === "1") return;
  root.dataset.ready = "1";

  const fab = document.getElementById("mp-fab");
  const panel = document.getElementById("mp-panel");
  const audio = document.getElementById("mp-audio");
  const cover = document.getElementById("mp-cover");
  const nowTitle = document.getElementById("mp-now-title");
  const nowArtist = document.getElementById("mp-now-artist");
  const progress = document.getElementById("mp-progress");
  const currentEl = document.getElementById("mp-current");
  const durationEl = document.getElementById("mp-duration");
  const playBtn = document.getElementById("mp-play");
  const playIcon = document.getElementById("mp-play-icon");
  const volume = document.getElementById("mp-volume");
  const loopBtn = document.getElementById("mp-loop");
  const hint = document.getElementById("mp-hint");
  const items = Array.from(document.querySelectorAll(".mp-track"));

  if (!fab || !panel || !audio) return;

  const PLAY_PATH = "M8 5v14l11-7z";
  const PAUSE_PATH = "M6 5h4v14H6zM14 5h4v14h-4z";
  let index = 0;
  let seeking = false;

  const fmt = (s) => {
    if (!isFinite(s) || s < 0) return "0:00";
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return m + ":" + String(sec).padStart(2, "0");
  };

  const setActive = () => {
    items.forEach((li, i) => li.classList.toggle("active", i === index));
    const t = tracks[index];
    if (!t) return;
    nowTitle.textContent = t.title;
    nowArtist.textContent = t.artist;
    cover.src = t.cover;
  };

  const playTrack = (i) => {
    if (!tracks.length) return;
    index = (i + tracks.length) % tracks.length;
    audio.src = tracks[index].src;
    audio.load();
    const p = audio.play();
    if (p && typeof p.catch === "function") p.catch(() => {});
    setActive();
  };

  const togglePlay = () => {
    if (!tracks.length) return;
    if (!audio.src) return playTrack(index);
    if (audio.paused) {
      const p = audio.play();
      if (p && typeof p.catch === "function") p.catch(() => {});
    } else {
      audio.pause();
    }
  };

  // ---- 按歌手筛选（下拉菜单）----
  const artistSelect = document.getElementById("mp-artist-select");
  let visibleIndices = tracks.map((_, i) => i);

  const applyFilter = (artist) => {
    visibleIndices = artist
      ? tracks.map((t, i) => (t.artist === artist ? i : -1)).filter((i) => i >= 0)
      : tracks.map((_, i) => i);
    const set = new Set(visibleIndices);
    items.forEach((li, i) => {
      const show = set.has(i);
      li.style.display = show ? "" : "none";
    });
    // 可见项按顺序重新编号
    visibleIndices.forEach((trackIndex, order) => {
      const num = items[trackIndex]?.querySelector(".mp-num");
      if (num) num.textContent = String(order + 1);
    });
    if (artistSelect && artistSelect.value !== (artist || "")) {
      artistSelect.value = artist || "";
    }
  };

  const buildArtists = () => {
    if (!artistSelect || !tracks.length) return;
    const counts = new Map();
    tracks.forEach((t) => counts.set(t.artist, (counts.get(t.artist) || 0) + 1));

    Array.from(counts.entries())
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "zh-CN"))
      .forEach(([artist, count]) => {
        const opt = document.createElement("option");
        opt.value = artist;
        opt.textContent = `${artist}（${count} 首）`;
        artistSelect.append(opt);
      });

    artistSelect.addEventListener("change", () => applyFilter(artistSelect.value));
  };

  // 在当前筛选范围内步进
  const step = (dir) => {
    if (!visibleIndices.length) return;
    const curPos = visibleIndices.indexOf(index);
    let nextPos;
    if (curPos === -1) {
      nextPos = dir > 0 ? 0 : visibleIndices.length - 1;
    } else {
      nextPos = (curPos + dir + visibleIndices.length) % visibleIndices.length;
    }
    playTrack(visibleIndices[nextPos]);
  };

  buildArtists();
  applyFilter("");

  fab.addEventListener("click", () => {
    const open = panel.classList.toggle("open");
    fab.classList.toggle("open", open);
    fab.setAttribute("aria-expanded", String(open));
  });
  document.getElementById("mp-close")?.addEventListener("click", () => {
    panel.classList.remove("open");
    fab.classList.remove("open");
    fab.setAttribute("aria-expanded", "false");
  });

  playBtn.addEventListener("click", togglePlay);
  document.getElementById("mp-prev")?.addEventListener("click", () => step(-1));
  document.getElementById("mp-next")?.addEventListener("click", () => step(1));
  loopBtn?.addEventListener("click", () => {
    audio.loop = !audio.loop;
    loopBtn.classList.toggle("active", audio.loop);
    loopBtn.setAttribute("title", audio.loop ? "取消循环" : "循环播放");
  });

  items.forEach((li) => {
    li.addEventListener("click", () => playTrack(Number(li.dataset.index)));
  });

  audio.addEventListener("play", () => {
    root.classList.add("is-playing");
    playIcon.querySelector("path").setAttribute("d", PAUSE_PATH);
    playBtn.setAttribute("aria-label", "暂停");
    setActive();
  });
  audio.addEventListener("pause", () => {
    root.classList.remove("is-playing");
    playIcon.querySelector("path").setAttribute("d", PLAY_PATH);
    playBtn.setAttribute("aria-label", "播放");
  });
  audio.addEventListener("loadedmetadata", () => {
    durationEl.textContent = fmt(audio.duration);
  });
  audio.addEventListener("timeupdate", () => {
    if (!seeking && audio.duration) {
      progress.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
    }
    currentEl.textContent = fmt(audio.currentTime);
  });
  audio.addEventListener("ended", () => {
    if (!audio.loop && visibleIndices.length > 1) step(1);
  });

  progress.addEventListener("pointerdown", () => { seeking = true; });
  const commitSeek = () => {
    if (audio.duration) audio.currentTime = (Number(progress.value) / 1000) * audio.duration;
    seeking = false;
  };
  progress.addEventListener("pointerup", commitSeek);
  progress.addEventListener("change", commitSeek);

  // 自动播放：浏览器只允许静音起播，首次交互后再解除静音
  const DEFAULT_VOLUME = 25;
  volume.value = String(DEFAULT_VOLUME);
  audio.volume = DEFAULT_VOLUME / 100;
  audio.muted = true;
  audio.preload = "auto";
  audio.loop = tracks.length === 1;
  loopBtn?.classList.toggle("active", audio.loop);
  loopBtn?.setAttribute("title", audio.loop ? "取消循环" : "循环播放");

  volume.addEventListener("input", () => {
    audio.volume = Math.min(1, Math.max(0, Number(volume.value) / 100));
    if (Number(volume.value) > 0) audio.muted = false;
  });

  const events = ["pointerdown", "keydown", "touchstart"];
  const enableSound = () => {
    audio.muted = false;
    if (hint) hint.style.display = "none";
    if (audio.paused) {
      const p = audio.play();
      if (p && typeof p.catch === "function") p.catch(() => {});
    }
    events.forEach((ev) => document.removeEventListener(ev, enableSound));
  };
  events.forEach((ev) => document.addEventListener(ev, enableSound, { once: true, passive: true }));

  setActive();
  playTrack(0);
})();
</script>

<style lang="stylus">
.music-player
  position fixed
  left 30px
  bottom 30px
  z-index 1000
  user-select none
  font-family inherit

.mp-fab
  position relative
  width 52px
  height 52px
  border-radius 50%
  border 1px solid var(--red-5)
  background var(--color-wrap)
  box-shadow 1px 2px 10px rgba(0, 0, 0, .2)
  cursor pointer
  display flex
  align-items center
  justify-content center
  padding 0
  transition .3s

  img
    width 30px
    height 30px
    transition .3s

  &:hover
    transform scale(1.08)
    border-color var(--red-2)

  &.open img
    transform rotate(90deg)

.is-playing .mp-fab img
  animation rotate-all 4s linear infinite

.mp-eq
  display none
  position absolute
  bottom -3px
  left 50%
  transform translateX(-50%)
  gap 2px

  i
    width 3px
    height 3px
    border-radius 50%
    background var(--red-2)

.is-playing .mp-eq
  display flex

.mp-panel
  position absolute
  left 0
  bottom 66px
  width 320px
  max-width calc(100vw - 32px)
  box-sizing border-box
  padding 16px
  border-radius 14px
  background var(--color-wrap)
  border 1px solid var(--red-5)
  box-shadow 0 8px 30px rgba(0, 0, 0, .35)
  opacity 0
  visibility hidden
  pointer-events none
  transform translateY(12px)
  transition .28s ease

  &.open
    opacity 1
    visibility visible
    pointer-events auto
    transform translateY(0)

.mp-header
  display flex
  align-items center
  justify-content space-between
  margin-bottom 14px

.mp-filter
  display flex
  align-items center
  gap 8px
  margin-bottom 12px

.mp-filter-label
  font-size 11px
  color var(--grey-9)
  flex none

.mp-select-wrap
  position relative
  flex 1
  min-width 0

.mp-select
  width 100%
  box-sizing border-box
  appearance none
  -webkit-appearance none
  padding 6px 26px 6px 10px
  border-radius 8px
  border 1px solid var(--red-5)
  background var(--color-wrap)
  color var(--color-default)
  font-size 12px
  font-family inherit
  cursor pointer
  transition .2s
  text-overflow ellipsis

  &:hover
    border-color var(--red-2)

  &:focus
    outline none
    border-color var(--red-1)
    box-shadow 0 0 0 2px var(--red-5-5)

  option
    background var(--color-wrap)
    color var(--color-default)

.mp-select-arrow
  position absolute
  right 6px
  top 50%
  transform translateY(-50%)
  width 16px
  height 16px
  fill var(--red-1)
  pointer-events none

.mp-title
  font-weight 700
  font-size 15px
  color var(--red-1)
  letter-spacing 1px

  small
    font-weight 400
    font-size 11px
    color var(--grey-9)
    margin-left 6px

.mp-icon-btn
  border 0
  background transparent
  color var(--red-1)
  width 30px
  height 30px
  padding 6px
  cursor pointer
  border-radius 6px
  display inline-flex
  align-items center
  justify-content center
  transition .2s

  svg
    width 18px
    height 18px
    fill currentColor

  &:hover
    background var(--red-5-5)

  &.active
    color var(--red-0)
    background var(--red-5)

.mp-now
  display flex
  align-items center
  gap 12px
  padding-bottom 12px
  border-bottom 1px solid var(--color-border)

  img
    border-radius 8px
    flex none
    background var(--red-5-5)

.mp-meta
  min-width 0
  display flex
  flex-direction column
  gap 4px

  strong
    font-size 14px
    color var(--color-default)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  small
    font-size 11px
    color var(--grey-9)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.mp-hint
  margin 8px 0 0
  font-size 10px
  line-height 1.5
  color var(--grey-9)

.mp-range
  width 100%
  height 4px
  margin 12px 0 4px
  appearance none
  border-radius 4px
  background var(--red-5)
  accent-color var(--red-1)
  cursor pointer

  &::-webkit-slider-thumb
    appearance none
    width 12px
    height 12px
    border-radius 50%
    background var(--red-1)
    border 0

.mp-time
  display flex
  justify-content space-between
  font-size 10px
  color var(--grey-9)

.mp-controls
  display flex
  align-items center
  justify-content center
  gap 16px
  margin 10px 0 4px

.mp-play
  width 42px
  height 42px
  border-radius 50%
  border 0
  background var(--red-1)
  color #fff
  cursor pointer
  display flex
  align-items center
  justify-content center
  box-shadow var(--shadow-red-6-shadow)
  transition .2s

  svg
    width 22px
    height 22px
    fill currentColor

  &:hover
    transform scale(1.08)

.mp-volume-row
  display flex
  align-items center
  gap 10px
  font-size 11px
  color var(--grey-9)

  .mp-range
    margin 4px 0

.mp-list
  list-style none
  margin 12px 0 0
  padding 0
  max-height 190px
  overflow-y auto

  &::-webkit-scrollbar
    width 6px

  &::-webkit-scrollbar-thumb
    background var(--red-5)
    border-radius 6px

.mp-track
  display flex
  align-items center
  gap 10px
  padding 7px 8px
  border-radius 8px
  cursor pointer
  transition .2s

  &:hover
    background var(--red-5-5)

  &.active
    background var(--red-5-5)

    strong, .mp-num
      color var(--red-1)

.mp-num
  font-size 11px
  color var(--grey-9)
  width 14px
  text-align center
  flex none

.mp-track-text
  display flex
  flex-direction column
  gap 2px
  min-width 0
  flex 1

  strong
    font-size 12px
    font-weight 600
    color var(--color-default)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  small
    font-size 10px
    color var(--grey-9)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.mp-playing-bars
  display none
  align-items flex-end
  gap 2px
  height 14px

  i
    width 3px
    background var(--red-1)
    animation mp-bar .8s ease-in-out infinite alternate

    &:nth-child(2)
      animation-delay .2s

    &:nth-child(3)
      animation-delay .4s

.mp-track.active .mp-playing-bars
  display flex

.mp-empty
  font-size 12px
  color var(--grey-9)
  text-align center
  padding 16px 0

@keyframes mp-bar
  0%
    height 4px
  100%
    height 14px

:global([data-theme='dark']) .mp-fab
  box-shadow 0 2px 12px rgba(0, 0, 0, .6)

@media screen and (max-width: 767px)
  .music-player
    left 16px
    bottom 16px

  .mp-fab
    width 46px
    height 46px

    img
      width 26px
      height 26px

  .mp-panel
    bottom 60px
</style>
