---
// 在文章里嵌入 B 站视频
// 用法（MDX 文件中）：
//   import BilibiliVideo from "../../components/mdx/BilibiliVideo.astro";
//   <BilibiliVideo bvid="BV1xx411c7mD" />
//   <BilibiliVideo bvid="BV1xx411c7mD" page={2} title="视频标题" />
interface Props {
  bvid: string;
  page?: number;
  title?: string;
}
const { bvid, page = 1, title = "" } = Astro.props;
const src = `https://player.bilibili.com/player.html?bvid=${encodeURIComponent(bvid)}&page=${page}&high_quality=1&autoplay=0`;
---

<div class="bilibili-video-wrap">
  <div class="bilibili-video">
    <iframe
      src={src}
      scrolling="no"
      frameborder="0"
      framespacing="0"
      allowfullscreen="true"
      allow="autoplay; fullscreen; picture-in-picture"
      title={title || "Bilibili 视频"}
      loading="lazy"
    ></iframe>
  </div>
  {title && <div class="bilibili-video-caption">{title}</div>}
</div>

<style lang="stylus">
.bilibili-video-wrap
  margin 20px 0

.bilibili-video
  position relative
  width 100%
  padding-top 56.25%
  border-radius 12px
  overflow hidden
  box-shadow var(--shadow-card)
  background #000

  iframe
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    border 0

.bilibili-video-caption
  margin-top 8px
  text-align center
  font-size 12px
  color var(--grey-9)
</style>
