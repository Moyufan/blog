---
import { PRELOADER } from "../../utils/config";
import { urlFor } from "../../utils/urlFor";
---

<div id="loader">
  <div class="loading-left-bg loading-bg"></div>
  <div class="loading-right-bg loading-bg"></div>
  <div class="spinner-box">
    <div class={PRELOADER.rotate ? "loading-notebook rotate" : "loading-notebook"}>
      <img
        src={urlFor("images/notebook.png")}
        width="150"
        height="150"
        alt=""
        class="icon"
      />
    </div>
    <div class="loading-word">{PRELOADER.text}</div>
  </div>
</div>

<script is:inline>
  var time = null;
  var endLoading = () => {
    if (!time) {
      document.body.style.overflow = "auto";
      document.getElementById("loader").classList.add("loading");
    } else {
      if (Date.now() - time > 500) {
        time = null;
        document.body.style.overflow = "auto";
        document.getElementById("loader").classList.add("loading");
      } else {
        setTimeout(endLoading, 500 - (Date.now() - time));
        time = null;
      }
    }
  };
  window.addEventListener("DOMContentLoaded", endLoading);
  document.addEventListener("astro:page-load", endLoading);
  document.getElementById("loader").addEventListener("click", endLoading);
</script>

<style lang="stylus">
:global([data-theme="dark"])
  #loader 
    .loading-bg
      background-color: rgba(20, 20, 20, .92)

    .spinner-box .loading-word
      color: var(--red-2, #d32f2f)

#loader
  .loading-bg
    position: fixed
    z-index: 1000
    width: 50%
    height: 100%
    background-color: rgba(251, 250, 248, .94)
    transition: .8s

  .loading-right-bg
    right: 0

  .spinner-box
    position: fixed
    z-index: 1001
    display: flex
    justify-content: center
    align-items: center
    width: 100%
    height: 100vh
    opacity: 1
    transition: .5s

    .loading-notebook
      opacity: .9
      filter: drop-shadow(0 0 12px rgba(183, 28, 28, .35))

    .rotate
      animation: rotate-all 2s linear infinite

    .loading-word
      position: absolute
      color: var(--red-1, #b71c1c)
      top: calc(50% + 110px)
      left: 50%
      transform: translate(-50%, -50%)
      font: 700 1.2rem 'LXGW WenKai Screen', -apple-system, PingFang SC,
      Microsoft YaHei, sans-serif;

#loader.loading 
  .loading-left-bg
	  transform: translate(-100%, 0)

  .loading-right-bg
	  transform: translate(100%, 0)

#loader.loading 
  .spinner-box
    opacity: 0
    visibility: hidden

@keyframes rotate-all
  100%
    transform: rotate(360deg)
</style>
