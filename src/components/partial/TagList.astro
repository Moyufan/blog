---
import { Icon } from "astro-icon/components";

import { urlFor } from "../../utils/urlFor";

type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

<div class="tag-wrap">
  {
    tags.map((tag) => {
      return (
        <div class="archives-tag-list-item">
          <Icon
            name="fa6-solid:tag"
            style="margin-right: 8px; vertical-align: bottom;"
            size={12}
          />
          <a class="archives-tag-list-link" href={urlFor(`tags/${tag}`)}>
            {tag}
          </a>
        </div>
      );
    })
  }
</div>

<style lang="stylus">
  .tag-wrap {
    display: flex;
    flex-wrap: wrap;
    padding: 10px 36px;

    a {
      text-decoration: none;
    }

    .archives-tag-list-item {
      color: var(--red-1);
      display: flex;
      align-items: center;
      text-decoration: none;
      text-transform: uppercase;
      background: var(--red-5-5);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 7px 13px;
      margin: 5px;
      transition: 0.2s ease;

      &:hover {
        background: var(--red-5);
        border-color: var(--red-3);
        transform: translateY(-1px);
      }
    }
    .archives-tag-list-link {
      color: var(--red-1);
      font-size: 12px;
    }
  }
</style>
