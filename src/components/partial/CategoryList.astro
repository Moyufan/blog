---
import { Icon } from "astro-icon/components";

import { urlFor } from "../../utils/urlFor";

type Props = {
  categories: string[];
};

const { categories } = Astro.props;
---

<div class="category-wrap">
  {
    categories.map((category) => {
      return (
        <div class="archives-category-list-item">
          <Icon
            name="fa6-solid:bookmark"
            style="margin-right: 8px; vertical-align: bottom;"
            size={14}
          />
          <a
            class="archives-category-list-link"
            href={urlFor(`categories/${category}`)}
          >
            {category}
          </a>
        </div>
      );
    })
  }
</div>

<style lang="stylus">
  .category-wrap {
    display: flex;
    flex-wrap: wrap;
    padding: 10px 36px;

    a {
      text-decoration: none;
    }

    .archives-category-list-item {
      color: var(--red-1);
      display: flex;
      align-items: center;
      text-decoration: none;
      text-transform: uppercase;
      border-radius: 8px;
      margin: 5px;
      border: 1px solid var(--color-border);
      background: var(--red-6);
      padding: 9px 17px;
      transition: 0.2s ease;

      &:hover {
        background: var(--red-5-5);
        border-color: var(--red-3);
        transform: translateY(-1px);
      }
    }
    .archives-category-list-link {
      color: var(--red-1);
      font-size: 14px;
    }
  }
</style>
