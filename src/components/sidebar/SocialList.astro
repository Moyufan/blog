---
import { Icon } from "astro-icon/components";

import { SOCIAL } from "../../utils/config";
---

<div class="sidebar-social">
  {
    SOCIAL &&
      Object.keys(SOCIAL).map((social) => {
        let name = `fa6-brands:${social}`;
        if (social === "email") {
          name = "fa6-solid:envelope";
        }

        return (
          <a
            href={(SOCIAL as any)[social]}
            aria-label={social}
            rel="noopener external nofollow noreferrer"
            target="_blank"
            class={social}
          >
            <Icon name={name} scale={16} />
          </a>
        );
      })
  }
</div>

<style lang="stylus">
  .sidebar-social {
    display: flex;
    flex-shrink: 0;
    justify-content: center;
    width: 70%;
    flex-wrap: wrap;

    svg {
      width: 20px;
      height: 20px;
      transition: transform 0.2s;
      will-change: transform;
      margin: 4px 8px;

      &:hover {
        transform: scale(1.2);
      }
    }

    /* 黑白风：社交图标统一中性灰，不再使用品牌色 */
    .email svg,
    .github svg,
    .google svg,
    .facebook svg,
    .twitter svg,
    .instagram svg,
    .linkedin svg,
    .pinterest svg,
    .youtube svg,
    .vimeo svg,
    .flickr svg,
    .dribbble svg,
    .behance svg,
    .bilibili svg {
      color: var(--red-2);
    }

    .weibo svg {
      color: #e6162d;
    }

    .zhihu svg {
      color: #0084ff;
    }

    .reddit svg {
      color: #ff4500;
    }

    .tumblr svg {
      color: #35465c;
    }

    .medium svg {
      color: #00ab6c;
    }

    .deviantart svg {
      color: #05cc47;
    }

    .stackoverflow svg {
      color: #f48024;
    }

    .keybase svg {
      color: #33a0ff;
    }

    .telegram svg {
      color: #0088cc;
    }

    .discord svg {
      color: #7289da;
    }

    .steam svg {
      color: #171a21;
    }
  }
</style>
